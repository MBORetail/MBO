# Zkopírujte do .env a doplňte. Soubor .env se necommituje.

# eBay – https://developer.ebay.com/my/keys (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Kaufland Seller API – Seller Portal > Nastavení > API
KAUFLAND_CLIENT_KEY=
KAUFLAND_SECRET_KEY=

# Vlastní prodejci, které nechcete počítat mezi konkurenci (čárkou oddělené, porovnává se bez ohledu na velikost písmen)
VLASTNI_PRODEJCI=

# --- Výpočet zisku a marže (výstup: list Přehled, sloupce "zisk EUR" a "marže %") ---
# Sloupec s nákupní cenou ve vstupním souboru (pokud se nejmenuje "nákupní cena"/"nakup"/"NC")
SLOUPEC_NAKUP=
# Měna nákupní ceny (CZK / EUR / PLN) a zda je uvedena s DPH (ano/ne)
NAKUP_MENA=CZK
NAKUP_S_DPH=ne
DPH_NAKUP=21

# DPH podle země prodeje (%)
DPH_DE=19
DPH_CZ=21
DPH_PL=23

# Provize marketplaců v % z ceny vč. DPH a dopravy, podle kategorie (parfém / kosmetika),
# + fixní poplatek v EUR za objednávku/položku.
PROVIZE_KAUFLAND_PARFEM=10
PROVIZE_KAUFLAND_KOSMETIKA=13
PROVIZE_EBAY_PARFEM=11
PROVIZE_EBAY_KOSMETIKA=12
FIX_EBAY_DE=0.35
FIX_KAUFLAND_DE=0
FIX_KAUFLAND_CZ=0

# Vaše náklady na dopravu 1 ks do dané země (EUR), 0 = nepočítat
DOPRAVA_DE=0
DOPRAVA_CZ=0

# eBay odhad prodejů: kolik nejlevnějších nabídek na EAN projít (každá = 1 dotaz navíc, 0 = vypnout).
# Běží až po zjištění cen, takže spotřebuje jen zbytek denního limitu eBay API.
EBAY_PRODEJE_TOP=3

# Amazon Selling Partner API (Seller Central > Apps and Services > Develop Apps)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
# Posíláte přes FBA? (ano/ne) – ovlivní odhad poplatků Amazonu (FBA = provize + fulfillment)
AMAZON_FBA=ne
# Provize Amazon jen pro případ, že API nevrátí skutečné poplatky
PROVIZE_AMAZON_PARFEM=15
PROVIZE_AMAZON_KOSMETIKA=15
